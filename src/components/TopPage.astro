---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
import Base from '../layouts/Base.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<Base title={t(lang, 'top.title')} description={t(lang, 'top.description')} lang={lang} path="/">

<LangSwitch lang={lang} path="/" />

<main>
  <section class="hero">
    <h1>Latte</h1>
    <p class="lead">{t(lang, 'top.tagline')}</p>
  </section>

  <section class="apps">
    <a href={`/${lang}/voice/`} class="app-card">
      <img src="/icon.png" alt="" class="app-icon" width="64" height="64">
      <div>
        <h2>VoiceLatte</h2>
        <p>{t(lang, 'top.voicelatte.desc')}</p>
      </div>
      <span class="arrow" aria-hidden="true">&rarr;</span>
    </a>
  </section>
</main>

<footer>
  <p>{t(lang, 'footer.copy')}</p>
</footer>

</Base>

<style>
  main { max-width: 480px; margin: 0 auto; padding: 0 1.5rem; }
  .hero { padding: 8rem 0 3rem; text-align: center; }
  .hero h1 { font-family: var(--font-display); font-size: 2.5rem; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 0.5rem; }
  .lead { font-size: 0.95rem; color: var(--dark-coffee); }
  .apps { padding: 2rem 0 8rem; }
  .app-card { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 1.5rem; border: 1px solid rgba(193,160,123,0.2); border-radius: 14px; text-decoration: none; color: var(--espresso); transition: border-color 0.15s; }
  .app-card:hover { border-color: var(--latte); }
  .app-icon { border-radius: 16%; flex-shrink: 0; }
  .app-card h2 { font-size: 1rem; font-weight: 700; margin-bottom: 0.15rem; }
  .app-card p { font-size: 0.85rem; color: var(--dark-coffee); line-height: 1.5; }
  .arrow { margin-left: auto; color: var(--latte); font-size: 1.1rem; }
  footer { background: var(--espresso); color: var(--cream); padding: 1.5rem; text-align: center; font-size: 0.75rem; opacity: 0.8; }
  @media (max-width: 500px) {
    .app-card { flex-direction: column; text-align: center; padding: 2rem 1.5rem; }
    .arrow { display: none; }
  }
</style>
