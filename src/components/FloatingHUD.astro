---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<div class="hud-wrapper">
  <div class="hud-track">
    <!-- State 1: Listening -->
    <div class="hud state-listening">
      <div class="indicator ind-brown">
        <div class="ind-glow"></div>
        <div class="ind-bg"></div>
        <svg class="ind-icon" viewBox="0 0 24 24" fill="none" width="13" height="13">
          <path d="M12 2a3 3 0 00-3 3v6a3 3 0 006 0V5a3 3 0 00-3-3z" fill="currentColor"/>
          <path d="M19 10a7 7 0 01-14 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
        </svg>
      </div>
      <div class="hud-body">
        <span class="hud-label">{t(lang, 'mock.hud.listening')}</span>
        <span class="hud-text">{t(lang, 'mock.hud.transcript')}</span>
      </div>
      <div class="waveform">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </div>
      <span class="hud-hint">⌃V stop</span>
    </div>

    <!-- State 2: Refining -->
    <div class="hud state-refining">
      <div class="indicator ind-amber">
        <div class="ind-glow"></div>
        <div class="ind-bg"></div>
        <svg class="ind-icon" viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
          <path d="M12 2l1.5 4.5L18 8l-4.5 1.5L12 14l-1.5-4.5L6 8l4.5-1.5L12 2z"/>
          <path d="M18 14l.75 2.25L21 17l-2.25.75L18 20l-.75-2.25L15 17l2.25-.75L18 14z" opacity="0.5"/>
        </svg>
        <div class="spinner"></div>
      </div>
      <div class="hud-body">
        <span class="hud-label">{t(lang, 'mock.hud.refining')}</span>
        <span class="hud-text">{t(lang, 'mock.hud.transcript.full')}</span>
      </div>
      <span class="hud-hint">⌃V stop</span>
    </div>

    <!-- State 3: Copied -->
    <div class="hud state-done">
      <div class="indicator ind-green">
        <div class="ind-glow"></div>
        <div class="ind-bg"></div>
        <svg class="ind-icon" viewBox="0 0 24 24" fill="none" width="14" height="14">
          <path d="M8 12.5l2.5 2.5 5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="hud-body">
        <span class="hud-label">{t(lang, 'mock.hud.done')}</span>
        <span class="hud-text">{t(lang, 'mock.hud.transcript.full')}</span>
      </div>
      <span class="paste-key">⌘V</span>
    </div>
  </div>
</div>

<style>
  /*
    Cycle: 6s total
    0–3s    Listening  (50%)
    3–4.2s  Refining   (20%)
    4.2–5.6s Done      (23%)
    5.6–6s  Reset       (7%)
  */

  .hud-wrapper {
    display: flex;
    justify-content: center;
    padding: 1.5rem 0 0.5rem;
  }

  .hud-track {
    position: relative;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Each state is absolutely stacked */
  .hud {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px 7px 8px;
    border-radius: 100px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    white-space: nowrap;
    opacity: 0;
    transition: none;
  }

  .state-listening {
    background: rgba(40, 24, 16, 0.85);
    box-shadow: 0 0 0 1px rgba(111,76,62,0.3) inset, 0 0 14px rgba(111,76,62,0.2), 0 4px 14px rgba(0,0,0,0.18);
    animation: fade-listening 6s ease-in-out infinite;
  }
  .state-refining {
    background: rgba(40, 28, 12, 0.85);
    box-shadow: 0 0 0 1px rgba(191,128,51,0.3) inset, 0 0 14px rgba(191,128,51,0.15), 0 4px 14px rgba(0,0,0,0.18);
    animation: fade-refining 6s ease-in-out infinite;
  }
  .state-done {
    background: rgba(20, 32, 18, 0.85);
    box-shadow: 0 0 0 1px rgba(89,154,77,0.3) inset, 0 0 14px rgba(89,154,77,0.15), 0 4px 14px rgba(0,0,0,0.18);
    animation: fade-done 6s ease-in-out infinite;
  }

  @keyframes fade-listening {
    0%, 2%    { opacity: 0; }
    5%, 47%   { opacity: 1; }
    50%, 100% { opacity: 0; }
    95%       { opacity: 0; }
  }
  @keyframes fade-refining {
    0%, 48%   { opacity: 0; }
    51%, 66%  { opacity: 1; }
    69%, 100% { opacity: 0; }
  }
  @keyframes fade-done {
    0%, 68%   { opacity: 0; }
    71%, 91%  { opacity: 1; }
    94%, 100% { opacity: 0; }
  }

  /* ── Indicator ── */
  .indicator {
    position: relative;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ind-glow {
    position: absolute;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    filter: blur(4px);
    animation: pulse-glow 2s ease-in-out infinite;
  }
  .ind-bg {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 50%;
  }
  .ind-icon {
    position: relative;
  }

  @keyframes pulse-glow {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50%      { transform: scale(1.15); opacity: 0.9; }
  }

  /* Brown (listening) */
  .ind-brown .ind-glow { background: rgba(111,76,62,0.35); }
  .ind-brown .ind-bg   { background: rgba(111,76,62,0.22); }
  .ind-brown .ind-icon { color: var(--latte); }

  /* Amber (refining) */
  .ind-amber .ind-glow { background: rgba(191,128,51,0.3); }
  .ind-amber .ind-bg   { background: rgba(191,128,51,0.18); }
  .ind-amber .ind-icon { color: #bf8033; }

  /* Green (done) */
  .ind-green .ind-glow { background: rgba(89,154,77,0.35); }
  .ind-green .ind-bg   { background: rgba(89,154,77,0.2); }
  .ind-green .ind-icon { color: #599a4d; }

  /* Spinner ring (refining only) */
  .spinner {
    position: absolute;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    border-top-color: rgba(191,128,51,0.5);
    animation: spin 1s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Body text ── */
  .hud-body {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .hud-label {
    font-size: 9px;
    font-weight: 500;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.02em;
  }
  .state-refining .hud-label { color: rgba(191,128,51,0.7); }
  .state-done .hud-label     { color: rgba(89,154,77,0.7); }

  .hud-text {
    font-size: 11.5px;
    font-weight: 500;
    color: rgba(255,255,255,0.88);
  }

  /* ── Waveform ── */
  .waveform {
    display: flex;
    align-items: center;
    gap: 1.5px;
    height: 18px;
  }
  .bar {
    width: 2px;
    border-radius: 1px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.8), rgba(255,255,255,0.3));
    animation: wave 1.2s ease-in-out infinite;
  }
  .bar:nth-child(1) { animation-delay: 0s; }
  .bar:nth-child(2) { animation-delay: 0.1s; }
  .bar:nth-child(3) { animation-delay: 0.2s; }
  .bar:nth-child(4) { animation-delay: 0.3s; }
  .bar:nth-child(5) { animation-delay: 0.4s; }
  .bar:nth-child(6) { animation-delay: 0.3s; }
  .bar:nth-child(7) { animation-delay: 0.2s; }
  .bar:nth-child(8) { animation-delay: 0.1s; }
  .bar:nth-child(9) { animation-delay: 0s; }
  @keyframes wave {
    0%, 100% { height: 3px; }
    50%      { height: 14px; }
  }

  /* ── Hints ── */
  .hud-hint {
    font-size: 8px;
    font-weight: 500;
    color: rgba(255,255,255,0.2);
  }
  .paste-key {
    font-size: 10px;
    font-weight: 700;
    color: rgba(255,255,255,0.9);
    padding: 2px 6px;
    background: rgba(255,255,255,0.15);
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .state-listening, .state-refining, .state-done { animation: none; }
    .state-listening { opacity: 1; }
    .ind-glow { animation: none; }
    .spinner { animation: none; }
    .bar { animation: none; height: 6px; }
  }
</style>
