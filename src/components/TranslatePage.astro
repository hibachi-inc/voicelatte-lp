---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
import Base from '../layouts/Base.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<Base title={t(lang, 'translate.title')} description={t(lang, 'translate.description')} lang={lang} path="/translate/" ogImage="/translatte-icon.png">

<LangSwitch lang={lang} path="/translate/" />

<main>
  <section class="hero">
    <div class="hero-top">
      <img src="/translatte-icon.png" alt="" class="hero-icon" width="88" height="88">
      <div class="hero-text">
        <h1>TransLatte</h1>
        <p class="lead">{t(lang, 'translate.lead.1')}<br>{t(lang, 'translate.lead.2')}</p>
      </div>
    </div>
    <div class="shortcut-demo">
      <span class="key">⌃</span>
      <span class="key-plus">+</span>
      <span class="key">T</span>
    </div>
    <div class="cta">
      <a href="#" class="btn-primary">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 12L3 7h3.5V2h3V7H13L8 12z" fill="currentColor"/><path d="M2 13v1h12v-1H2z" fill="currentColor"/></svg>
        {t(lang, 'translate.btn.download')}
      </a>
    </div>
  </section>

  <section class="how">
    <h2>{t(lang, 'translate.how')}</h2>
    <ol class="steps">
      <li><span class="step-num">1</span><div><strong>{t(lang, 'translate.step1.title')}</strong><p>{t(lang, 'translate.step1.desc')}</p></div></li>
      <li><span class="step-num">2</span><div><strong>{t(lang, 'translate.step2.title')}</strong><p>{t(lang, 'translate.step2.desc')}</p></div></li>
      <li><span class="step-num">3</span><div><strong>{t(lang, 'translate.step3.title')}</strong><p>{t(lang, 'translate.step3.desc')}</p></div></li>
    </ol>
  </section>

  <section class="points">
    <div class="point">
      <h2>{t(lang, 'translate.point1.title')}</h2>
      <p>{t(lang, 'translate.point1.desc')}</p>
    </div>
    <div class="point">
      <h2>{t(lang, 'translate.point2.title')}</h2>
      <p>{t(lang, 'translate.point2.desc')}</p>
    </div>
  </section>

  <section class="nuance">
    <h2>{t(lang, 'translate.nuance.title')}</h2>
    <p class="nuance-desc">{t(lang, 'translate.nuance.desc')}</p>
    <div class="nuance-card">
      <div class="nuance-row nuance-original">
        <span class="nuance-label">Original</span>
        <p>{t(lang, 'translate.nuance.original')}</p>
      </div>
      <div class="nuance-row nuance-translation">
        <span class="nuance-label">Translation</span>
        <p>{t(lang, 'translate.nuance.translation')}</p>
      </div>
      <div class="nuance-row nuance-explain">
        <span class="nuance-label"><span class="nuance-dot"></span>{t(lang, 'translate.nuance.label')}</span>
        <p>{t(lang, 'translate.nuance.text')}</p>
      </div>
    </div>
  </section>

  <section class="privacy-badge">
    <p>{t(lang, 'translate.privacy')}</p>
  </section>
</main>

<footer>
  <p>{t(lang, 'footer.copy')}</p>
</footer>

</Base>

<style>
  main { max-width: 560px; margin: 0 auto; padding: 0 1.5rem; }

  /* Hero */
  .hero { padding: 6rem 0 3rem; text-align: center; }
  .hero-top { display: flex; align-items: center; gap: 1.25rem; justify-content: center; }
  .hero-icon { border-radius: 22%; flex-shrink: 0; }
  .hero-text { text-align: left; }
  .hero-text h1 { font-family: var(--font-display); font-size: 2rem; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 0.25rem; }
  .lead { font-size: 0.9rem; color: var(--dark-coffee); line-height: 1.7; }

  /* Shortcut demo */
  .shortcut-demo { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin: 2rem 0 0; }
  .key { display: inline-flex; align-items: center; justify-content: center; background: var(--white); border: 1px solid rgba(193,160,123,0.3); border-radius: 8px; padding: 0.3rem 0.75rem; font-family: 'Noto Sans JP', monospace; font-size: 1.1rem; font-weight: 600; color: var(--espresso); box-shadow: 0 2px 0 rgba(92,57,40,0.08); }
  .key-plus { color: var(--latte); font-size: 1rem; }

  /* CTA */
  .cta { display: flex; gap: 0.75rem; justify-content: center; margin-top: 1.5rem; flex-wrap: wrap; }
  .btn-primary { display: inline-flex; align-items: center; gap: 0.4rem; background: var(--espresso); color: var(--cream); font-size: 0.85rem; font-weight: 600; padding: 0.65rem 1.2rem; border-radius: 10px; text-decoration: none; transition: opacity 0.15s; }
  .btn-primary:hover { opacity: 0.85; }
  .btn-ghost { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--espresso); font-size: 0.85rem; font-weight: 500; padding: 0.65rem 1.2rem; border-radius: 10px; border: 1px solid rgba(193,160,123,0.3); text-decoration: none; transition: border-color 0.15s; }
  .btn-ghost:hover { border-color: var(--latte); }

  /* How it works */
  .how { padding: 3rem 0; border-top: 1px solid rgba(193,160,123,0.15); }
  .how h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: 1.5rem; }
  .steps { list-style: none; display: flex; flex-direction: column; gap: 1.25rem; }
  .steps li { display: flex; gap: 1rem; align-items: flex-start; }
  .step-num { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--cream); color: var(--espresso); font-size: 0.8rem; font-weight: 700; flex-shrink: 0; }
  .steps strong { display: block; font-size: 0.95rem; margin-bottom: 0.15rem; }
  .steps p { font-size: 0.85rem; color: var(--dark-coffee); line-height: 1.6; }

  /* Points */
  .points { padding: 2rem 0 3rem; display: flex; flex-direction: column; gap: 2rem; }
  .point { padding: 1.5rem; border: 1px solid rgba(193,160,123,0.15); border-radius: 14px; background: var(--white); }
  .point h2 { font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; }
  .point p { font-size: 0.85rem; color: var(--dark-coffee); line-height: 1.75; }

  /* Nuance */
  .nuance { padding: 2rem 0 3rem; border-top: 1px solid rgba(193,160,123,0.15); }
  .nuance h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; }
  .nuance-desc { font-size: 0.85rem; color: var(--dark-coffee); line-height: 1.7; margin-bottom: 1.5rem; }
  .nuance-card { border: 1px solid rgba(193,160,123,0.2); border-radius: 16px; overflow: hidden; background: var(--white); }
  .nuance-row { padding: 1rem 1.25rem; }
  .nuance-row + .nuance-row { border-top: 1px solid rgba(193,160,123,0.1); }
  .nuance-label { display: block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--latte); margin-bottom: 0.35rem; }
  .nuance-original p, .nuance-translation p { font-size: 1rem; font-weight: 500; color: var(--espresso); line-height: 1.5; }
  .nuance-translation { background: rgba(193,160,123,0.04); }
  .nuance-explain { background: rgba(193,160,123,0.08); }
  .nuance-explain .nuance-label { color: var(--espresso); display: flex; align-items: center; gap: 0.4rem; }
  .nuance-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--latte); }
  .nuance-explain p { font-size: 0.85rem; color: var(--dark-coffee); line-height: 1.8; }

  /* Privacy badge */
  .privacy-badge { text-align: center; padding: 2rem 0 4rem; }
  .privacy-badge p { display: inline-block; font-size: 0.8rem; color: var(--dark-coffee); background: var(--cream); padding: 0.5rem 1.25rem; border-radius: 100px; letter-spacing: 0.01em; }

  /* Footer */
  footer { background: var(--espresso); color: var(--cream); padding: 1.5rem; text-align: center; font-size: 0.75rem; opacity: 0.8; }

  @media (max-width: 500px) {
    .hero-top { flex-direction: column; }
    .hero-text { text-align: center; }
    .hero-icon { width: 72px; height: 72px; }
  }
</style>
